class AVLNode:
    def __init__(self, enrollment_id, student_name, course_name):
        self.enrollment_id = enrollment_id
        self.student_name = student_name
        self.course_name = course_name
        self.height = 1
        self.left = None
        self.right = None
class AVLTree:
    def __init__(self):
        self.root = None
    def height(self, node):
        return node.height if node else 0
    def balance_factor(self, node):
        return self.height(node.left) - self.height(node.right) if node else 0
    def update_height(self, node):
        
        node.height = 1 + max(self.height(node.left), self.height(node.right))
    def right_rotate(self, y):
        x = y.left
        T2 = x.right
        x.right = y
        y.left = T2
        self.update_height(y)
        self.update_height(x)
        return x
    def left_rotate(self, x):
        y = x.right
        T2 = y.left
        y.left = x
        x.right = T2
        self.update_height(x)
        self.update_height(y)
        return y
    def _insert(self, node, enrollment_id, student_name, course_name):
        if not node:
            return AVLNode(enrollment_id, student_name, course_name)
        if enrollment_id < node.enrollment_id:
            node.left = self._insert(node.left, enrollment_id, student_name, course_name)
        elif enrollment_id > node.enrollment_id:
            node.right = self._insert(node.right, enrollment_id, student_name, course_name)
        else:
            node.student_name = student_name
            node.course_name = course_name
            return node
        self.update_height(node)
        balance = self.balance_factor(node)
        if balance > 1 and enrollment_id < node.left.enrollment_id:
            return self.right_rotate(node)
        if balance < -1 and enrollment_id > node.right.enrollment_id:
            return self.left_rotate(node)
        if balance > 1 and enrollment_id > node.left.enrollment_id:
            node.left = self.left_rotate(node.left)
            return self.right_rotate(node)
        if

        balance < -1 and enrollment_id < node.right.enrollment_id:
            node.right = self.right_rotate(node.right)

            return self.left_rotate(node)
        return node
    def insert(self, enrollment_id, student_name, course_name):
        self.root = self._insert(self.root, enrollment_id, student_name, course_name)
    def _min_value_node(self, node):
        current = node
        while current.left:
            current = current.left
        return current
    def _delete(self, node, enrollment_id):
        if not node:
            return node
        if enrollment_id < node.enrollment_id:
            node.left = self._delete(node.left, enrollment_id)
        elif enrollment_id > node.enrollment_id:
            node.right = self._delete(node.right, enrollment_id)
        else:
            if not node.left:
                return node.right
            elif not node.right:
                return node.left
            temp = self._min_value_node(node.right)
            node.enrollment_id = temp.enrollment_id
            node.student_name = temp.student_name
            node.course_name = temp.course_name
            node.right = self._delete(node.right, temp.enrollment_id)
        if not node:
            return node
        self.update_height(node)
        balance = self.balance_factor(node)
        if balance > 1 and self.balance_factor(node.left) >= 0:
            return self.right_rotate(node)
        if balance > 1 and self.balance_factor(node.left) < 0:
            node.left = self.left_rotate(node.left)
            return self.right_rotate(node)
        if balance < -1 and self.balance_factor(node.right) <= 0:
            return self.left_rotate(node)
        if balance < -1 and self.balance_factor(node.right) > 0:
            node.right = self.right_rotate(node.right)
            return self.left_rotate(node)
        return node
    def delete(self, enrollment_id):
        self.root = self._delete(self.root, enrollment_id)
    def search_by_id(self, enrollment_id):
        curr = self.root
        while curr:
            if enrollment_id == curr.enrollment_id:
                return curr
            elif enrollment_id < curr.enrollment_id:
                curr = curr.left
            else:
                curr = curr.right
        return None
    def search_by_name(self, student_name):
        results = []
        name_lower = student_name.lower()
        def _inorder(n):
            if n:
                _inorder(n.left)
                if n.student_name.lower() == name_lower:
                    results.append(n)
                _inorder(n.right)
        _inorder(self.root)
        return results
    def traverse(self):
        res = []
        def _inorder(n):
            if n:
                _inorder(n.left)
                res.append((n.enrollment_id, n.student_name, n.course_name))
                _inorder(n.right)
        _inorder(self.root)
        return res
    def count(self):
        return len(self.traverse())
def display_current(avl):
    print("\n" + "=" * 50)
    print(f"Total Enrollments: {avl.count()}")
    records = avl.traverse()
    print("Current Records (Sorted by Enrollment ID):")
    if not records:
        print("  [No enrollments found]")
    else:
        for r in records:
            print(f"  ID: {r[0]} | Student: {r[1]} | Course: {r[2]}")
    print("=" * 50)
